# Checkster Backend — copy to backend/.env and fill in real values.
# backend/.env is git-ignored. NEVER commit real secrets to version control.

# ----------------------------------------------------------------------------
# 1. Google AI Studio / Gemini API (Required for AI Inspection, OCR & Explain)
# ----------------------------------------------------------------------------
# Create a key at: https://aistudio.google.com/apikey
# IMPORTANT: Google AI Studio / Gemini API credentials are SEPARATE from
# Google Maps Platform credentials. Do not assume GEMINI_API_KEY grants access
# to Google Places or Google Maps APIs.
GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT=45
GEMINI_MAX_RETRIES=2

# ----------------------------------------------------------------------------
# 2. Google Maps Platform (Optional — enables live external Places discovery)
# ----------------------------------------------------------------------------
# Create a separate key in Google Cloud Console with Places API enabled:
GOOGLE_MAPS_API_KEY=

# ----------------------------------------------------------------------------
# 3. Authentication, Storage & Database
# ----------------------------------------------------------------------------
CHECKSTER_AUTH_SECRET=change-this-to-a-long-random-secret-in-production
# Optional: override local SQLite path or provide Supabase JWT secret
# CHECKSTER_DATA_DIR=./data
# SUPABASE_JWT_SECRET=

# ----------------------------------------------------------------------------
# 4. Server & Rate Limits
# ----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://hackathon-giki-2.vercel.app
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MINUTE=30
